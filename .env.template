MONGODB_USER="your-mongodb-user"
MONGODB_PASSWORD="your-mongodb-password"
MONGODB_DB="your-mongodb-database"
MONGODB_PORT="27017"
MONGODB_HOST="localhost"

INFERENCE_PROVIDER="your-inference-provider"
STT_PROVIDER="your-stt-provider"
# TTS_PROVIDER: local (pocket_tts) | lmstudio (LM Studio TTS endpoint) | remote (OpenAI-compatible)
TTS_PROVIDER="local"
# TTS_MODEL: adapter filename in tts/models/ (without .py) — also used as model ID if no adapter found
# TTS_MODEL="vibevoice-realtime-0.5b"
TTS_HOST="http://localhost:1234/v1"
TTS_API_KEY="your-tts-api-key"
# MODEL_GENERALIST: large model for chat, wrapping, and general application reasoning.
# Recommended for 64GB unified RAM (Apple Silicon):
#   qwen3-30b-a3b-instruct-2507-mlx   (30B total / 3B active, MLX 4-bit, instruct-tuned)
# Smaller / fallback options:
#   qwen2.5-32b-instruct-mlx          (32B dense, slower, ~24GB)
#   qwen2.5-14b-instruct-mlx          (14B dense, fast, less reliable on edge cases)
MODEL_GENERALIST="your-generalist-model"
MODEL_EMBEDDING="your-embedding-model"
EMBEDDING_DIM="your-embedding-dimension"
# Dedicated instruction-following model for multi-step web research.
MODEL_RESEARCH="your-research-model"
# MODEL_INTENT: lean model for stateless classification (routing, topic extraction,
# query rewrite). Stays 8B for reliable structured JSON output.
# Falls back to MODEL_GENERALIST if unset.
MODEL_INTENT="your-intent-model"
# MODEL_VLM: vision language model for image description (e.g. moondream, llava, qwen3-vl)
MODEL_VLM="your-vlm-model"
MODEL_HOST="http://localhost:1234/v1"

ORS_API_KEY="your-ors-api-key"
TAVILY_API_KEY="your-tavily-api-key"

# Local SearXNG search skill
SEARXNG_URL="http://127.0.0.1:8080"
SEARXNG_PORT="8080"

HUE_BRIDGE_IP="your-hue-bridge-ip"

SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"

SPOONACULAR_API_KEY="your-spoonacular-api-key"

OPENAI_API_KEY="your-openai-api-key"
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Optional settings not currently active in .env:
# Chat memory injection: only relevant personal context is used by default.
# Maximum number of relevant memories injected into each chat turn (default: 2).
MEMORY_MAX_ITEMS="your-memory-max-items"
# Maximum number of characters of memory text injected into each chat turn (default: 500).
MEMORY_MAX_CHARS="your-memory-max-chars"
# Number of turns before a recently used memory can be selected again (default: 4).
MEMORY_COOLDOWN_TURNS="your-memory-cooldown-turns"
# Short-term CHAT context limits (durable user facts remain in LangMem).
MAX_HISTORY_MESSAGES="your-max-history-messages"
CHAT_PROMPT_MAX_TOKENS="your-chat-prompt-max-tokens"
CHAT_CONTEXT_MAX_TOKENS="your-chat-context-max-tokens"
HISTORY_USER_MAX_CHARS="your-history-user-max-chars"
HISTORY_ASSISTANT_MAX_CHARS="your-history-assistant-max-chars"
SUMMARY_MAX_CHARS="your-summary-max-chars"
# MODEL_PLANNING: optional dedicated model for multi-step planning; falls back to generalist.
# MODEL_PLANNING="qwen3-14b-instruct"
# Optional Telegram restriction:
# TELEGRAM_ALLOWED_CHAT_IDS="123456789,987654321"
